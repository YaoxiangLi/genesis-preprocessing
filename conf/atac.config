manifest {
    name = 'genesis/bulk-atac'
    version = '0.2.0'
    nextflowVersion = '>=25.10.4,<26'
}
params {
    manifest = null
    source = null
    outdir = null
    cpus = 2
    memory = '4 GB'
    time = '12h'
    images = new groovy.json.JsonSlurper().parse(new File("${projectDir}/../conf/atac-images.json"))
}
process {
    executor = 'local'
    cpus = params.cpus
    memory = params.memory
    time = params.time
    shell = ['/bin/bash', '-euo', 'pipefail']
}
profiles {
    local {
        process.executor = 'local'
        process.resourceLimits = [cpus: nextflow.util.SysHelper.getAvailCpus(), memory: nextflow.util.SysHelper.getAvailMemory()]
    }
    docker { docker.enabled = true; docker.runOptions = '-u $(id -u):$(id -g)' }
    apptainer { apptainer.enabled = true; apptainer.autoMounts = true }
    podman { podman.enabled = true }
    shifter { shifter.enabled = true }
    slurm { process.executor = 'slurm'; executor.queueSize = 50 }
    sherlock { process.executor = 'slurm'; process.queue = 'normal'; executor.queueSize = 50 }
    pbspro { process.executor = 'pbspro' }
    lsf { process.executor = 'lsf' }
    sge { process.executor = 'sge' }
}
trace { enabled = true; overwrite = true; file = "${params.outdir}/trace.tsv"; fields = 'task_id,hash,name,status,exit,realtime,peak_rss,rchar,wchar,container,workdir' }
report { enabled = true; overwrite = true; file = "${params.outdir}/execution.html" }
timeline { enabled = true; overwrite = true; file = "${params.outdir}/timeline.html" }
dag { enabled = true; overwrite = true; file = "${params.outdir}/dag.html" }

includeConfig 'execution.config'

env.PYTHONDONTWRITEBYTECODE = '1'
