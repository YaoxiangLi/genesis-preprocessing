manifest {
    name = 'kundajelab/genesis'
    description = 'Plant DAP-seq processing with bwa-mem2, SPP, MACS3 and deepTools'
    nextflowVersion = '>=25.10.4,<26'
}
plugins {
    id 'nf-dotenv@1.0.0'
}
dotenv {
    filename = '.env'
    relative = '.'
}
params {
    input = null
    references = "${projectDir}/references"
    workspace = "${projectDir}/workspace"
    cpus = 2
    memory = '8 GB'
    time = '4h'
    index_memory = '32 GB'
    index_time = '8h'
    slurm_queue = 'normal'
    bwa_batch_size = 10000000
    bwa_seed_length = 19
    bwa_max_seed_occurrences = 10000
    bwa_score_threshold = 30
    spp_script = "${projectDir}/vendor/phantompeakqualtools/run_spp.R"
}
workDir = "${projectDir}/work"
process {
    executor = 'local'
    shell = ['/bin/bash', '-euo', 'pipefail']
    errorStrategy = 'terminate'
}
profiles {
    local { process.executor = 'local' }
    sherlock {
        process.executor = 'slurm'
        process.queue = params.slurm_queue
        executor.queueSize = 50
    }
    conda { conda.enabled = true }
    docker {
        conda.enabled = false
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        conda.enabled = false
        apptainer.enabled = true
    }
    test {
        params.cpus = 2
        params.memory = '2 GB'
        params.time = '5m'
        params.index_memory = '2 GB'
        params.index_time = '5m'
    }
}
conda {
    useMicromamba = true
    cacheDir = "${params.workspace}/conda_cache"
    createTimeout = '1h'
}
apptainer {
    autoMounts = true
    cacheDir = "${params.workspace}/apptainer_cache"
}
