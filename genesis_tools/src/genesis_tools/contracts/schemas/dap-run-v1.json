{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "sheet_sha256",
    "context",
    "samples",
    "inputs",
    "references",
    "outputs",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "const": "genesis-dap-run"
    },
    "sheet_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "git_sha",
        "source_status",
        "nextflow_version",
        "profile",
        "source_hashes",
        "parameters"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "git_sha": {
          "type": "string",
          "minLength": 1
        },
        "source_status": {
          "enum": [
            "clean",
            "dirty",
            "UNKNOWN"
          ]
        },
        "nextflow_version": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "source_hashes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bwa",
            "spp_read_length",
            "spp_script_sha256",
            "download_batch_size",
            "mapq_filter",
            "flag_exclude",
            "alignment_duplicates",
            "peak_duplicates",
            "peak_format",
            "quantification_unit",
            "track_normalization",
            "track_bin_size",
            "strand_denominator"
          ],
          "properties": {
            "bwa": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "batch_size",
                "seed_length",
                "max_seed_occurrences",
                "score_threshold"
              ],
              "properties": {
                "batch_size": {
                  "type": "integer",
                  "minimum": 1
                },
                "seed_length": {
                  "type": "integer",
                  "minimum": 1
                },
                "max_seed_occurrences": {
                  "type": "integer",
                  "minimum": 1
                },
                "score_threshold": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "spp_read_length": {
              "type": "integer",
              "minimum": 1
            },
            "spp_script_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "download_batch_size": {
              "type": "integer",
              "minimum": 1
            },
            "mapq_filter": {
              "type": "string",
              "minLength": 1
            },
            "flag_exclude": {
              "type": "integer",
              "minimum": 1
            },
            "alignment_duplicates": {
              "type": "string",
              "minLength": 1
            },
            "peak_duplicates": {
              "type": "string",
              "minLength": 1
            },
            "peak_format": {
              "type": "string",
              "minLength": 1
            },
            "quantification_unit": {
              "type": "string",
              "minLength": 1
            },
            "track_normalization": {
              "type": "string",
              "minLength": 1
            },
            "track_bin_size": {
              "type": "integer",
              "minimum": 1
            },
            "strand_denominator": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sample_id",
          "species",
          "read1_url",
          "read2_url",
          "control_sample",
          "reference_fasta"
        ],
        "properties": {
          "sample_id": {
            "type": "string",
            "minLength": 1
          },
          "species": {
            "type": "string",
            "minLength": 1
          },
          "read1_url": {
            "type": "string",
            "minLength": 1
          },
          "read2_url": {
            "type": "string",
            "minLength": 1
          },
          "control_sample": {
            "type": "string",
            "minLength": 1
          },
          "reference_fasta": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sample_id",
          "mate",
          "url",
          "sha256",
          "retention"
        ],
        "properties": {
          "sample_id": {
            "type": "string",
            "minLength": 1
          },
          "mate": {
            "enum": [
              "read1",
              "read2"
            ]
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "retention": {
            "const": "work-cache"
          }
        }
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "filename",
          "contigs",
          "sizes_sha256",
          "sizes_cache",
          "index_cache",
          "contig_order"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "filename": {
            "type": "string",
            "minLength": 1
          },
          "contigs": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "integer",
              "minimum": 1
            }
          },
          "sizes_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "sizes_cache": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schema_version",
              "kind",
              "mode",
              "source_basename",
              "fasta_sha256",
              "compressed_fasta_sha256",
              "generator",
              "artifacts"
            ],
            "properties": {
              "schema_version": {
                "type": "integer",
                "const": 1
              },
              "kind": {
                "enum": [
                  "chrom-sizes",
                  "bwa-mem2"
                ]
              },
              "mode": {
                "enum": [
                  "real",
                  "stub"
                ]
              },
              "source_basename": {
                "type": "string",
                "minLength": 1
              },
              "fasta_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "compressed_fasta_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "generator": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "container",
                  "recipe_sha256",
                  "version",
                  "version_stderr"
                ],
                "properties": {
                  "container": {
                    "type": "string",
                    "minLength": 1
                  },
                  "engine": {
                    "type": "string",
                    "minLength": 1
                  },
                  "recipe_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "version": {
                    "type": "string"
                  },
                  "version_stderr": {
                    "type": "string"
                  }
                }
              },
              "artifacts": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          "index_cache": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schema_version",
              "kind",
              "mode",
              "source_basename",
              "fasta_sha256",
              "compressed_fasta_sha256",
              "generator",
              "artifacts"
            ],
            "properties": {
              "schema_version": {
                "type": "integer",
                "const": 1
              },
              "kind": {
                "enum": [
                  "chrom-sizes",
                  "bwa-mem2"
                ]
              },
              "mode": {
                "enum": [
                  "real",
                  "stub"
                ]
              },
              "source_basename": {
                "type": "string",
                "minLength": 1
              },
              "fasta_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "compressed_fasta_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "generator": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "container",
                  "recipe_sha256",
                  "version",
                  "version_stderr"
                ],
                "properties": {
                  "container": {
                    "type": "string",
                    "minLength": 1
                  },
                  "engine": {
                    "type": "string",
                    "minLength": 1
                  },
                  "recipe_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "version": {
                    "type": "string"
                  },
                  "version_stderr": {
                    "type": "string"
                  }
                }
              },
              "artifacts": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          "contig_order": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "outputs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sha256",
          "size"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "step",
          "subjects",
          "mode",
          "attempt",
          "engine",
          "container",
          "requested",
          "observed",
          "script_sha256"
        ],
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1
          },
          "step": {
            "enum": [
              "DOWNLOAD",
              "FASTQC",
              "METADATA",
              "BWA_MEM2_ALIGN",
              "QC",
              "TRACKS",
              "CALL_PEAKS",
              "QUANTIFY",
              "MULTIQC"
            ]
          },
          "subjects": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "mode": {
            "enum": [
              "real",
              "stub"
            ]
          },
          "attempt": {
            "type": "integer",
            "minimum": 1
          },
          "engine": {
            "type": "string",
            "minLength": 1
          },
          "container": {
            "type": [
              "string",
              "null"
            ]
          },
          "requested": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cpus",
              "memory_bytes",
              "time_ms"
            ],
            "properties": {
              "cpus": {
                "type": "integer",
                "minimum": 1
              },
              "memory_bytes": {
                "type": "integer",
                "minimum": 1
              },
              "time_ms": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "observed": {
            "type": "null"
          },
          "script_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genesis.example/schemas/dap-run-v1.json",
  "title": "Genesis DAP execution evidence v1"
}
